    "proof_schema": "moor.funnel-proof",
    "proof_required_for_mutations": true,
    "protected_paths": "scripts/funnel-protected-paths.json",
    "owner_signature_required_for_funnel_law": true,
    "owner_public_key": "funnel-owner-public.pem",
    "owner_private_key_stored": false,
    "branch_protection_required_for_final_enforcement": true
  }
