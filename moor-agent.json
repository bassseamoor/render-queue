  "zero_key": true,
  "routes": {
    "exact_reference": "reference",
    "navigation": "direct",
    "retrieval": "Bin",
    "unresolved_decisions": "Funnel",
    "resolved_execution": "Harness",
    "verification": "Verifier"
  },
  "funnel": {
    "contract": "FUNNEL.md",
    "runtime": "quiz-funnel-v3.html",
    "project_id": "funnel",
    "architecture": "pulse-learning-spine-blueprints.json",
    "canonical_version": "v45-armored",
    "kernel": "funnel-kernel.js",
    "required_stages": [
      "page0",
      "references",
      "distill",
      "decisions",
      "replay",
      "verdict"
