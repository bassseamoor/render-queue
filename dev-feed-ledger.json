  "policy": {
    "purpose": "Owner-visible, append-only record of what workers/chats are trying to add, which pipeline it entered, what actually shipped, and what remains missing.",
    "completion_rule": "A worker may report technical completion before owner visibility, but must not report owner-visible completion until a Dev Feed event proves the result can be found from Pulse or its explicitly named canonical destination.",
    "stages": [
      "requested",
      "funneled",
      "blueprint",
      "building",
      "verified",
      "pulse",
      "main",
      "owner-visible"
    ],
    "note": "GitHub commits and pull requests are also observed live by the Dev Feed UI. Explicit events remain necessary for semantic pipeline meaning that Git history alone cannot infer."
  },
