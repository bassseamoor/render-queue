{
  "schema": "moor.procedural-generator-inventory",
  "version": 1,
  "rule": "Inventory only. Determinism claims are evidence-scoped; D0/D1/D2/D3 status is not upgraded without replay proof.",
  "generators": [
    {
      "generator_id": "seed-rng",
      "version": "1",
      "provides": [
        "deterministic-rng",
        "named-substreams"
      ],
      "input_types": [
        "seed",
        "stream-name"
      ],
      "output_types": [
        "rng-stream"
      ],
      "determinism_level": "D3",
      "source": "components/seed-rng/rng.js",
      "verification_refs": [
        "tests/wonder-haven-checks.cjs"
      ],
      "status": "verified-existing"
    },
    {
      "generator_id": "seed-codec",
      "version": "1",
      "provides": [
        "seed-encode",
        "seed-decode"
      ],
      "input_types": [
        "seed"
      ],
      "output_types": [
        "encoded-seed"
      ],
      "determinism_level": "D3",
      "source": "components/seed-codec/codec.js",
      "verification_refs": [
        "tests/wonder-haven-checks.cjs"
      ],
      "status": "verified-existing"
    },
    {
      "generator_id": "terrain-core",
      "version": "1",
      "provides": [
        "terrain-heightfield",
        "terrain-sculpt"
      ],
      "input_types": [
        "seed",
        "terrain-params"
      ],
      "output_types": [
        "terrain-canvas",
        "terrain-field"
      ],
      "determinism_level": "D1",
      "source": "components/terrain-core/source/terrain-core.mjs",
      "verification_refs": [
        "tests/pulse-checks.cjs"
      ],
      "status": "existing-needs-replay-proof"
    },
    {
      "generator_id": "terrain-field",
      "version": "1",
      "provides": [
        "detailed-terrain-field"
      ],
      "input_types": [
        "seed",
        "field-params"
      ],
      "output_types": [
        "terrain-field"
      ],
      "determinism_level": "D1",
      "source": "components/terrain-field/field.glsl",
      "verification_refs": [
        "tests/pulse-checks.cjs"
      ],
      "status": "existing-needs-replay-proof"
    },
    {
      "generator_id": "planet-workshop",
      "version": "3.0.0",
      "provides": [
        "seeded-planet",
        "terrain-geology",
        "hydrology"
      ],
      "input_types": [
        "seed",
        "planet-params"
      ],
      "output_types": [
        "planet-terrain",
        "environment-recipe"
      ],
      "determinism_level": "D1",
      "source": "moor-planet-workshop.html",
      "verification_refs": [
        "tests/pulse-checks.cjs"
      ],
      "status": "verified-interface-replay-pending"
    },
    {
      "generator_id": "living-garden",
      "version": "1.0.0",
      "provides": [
        "procedural-vegetation",
        "seeded-garden",
        "ecology-output"
      ],
      "input_types": [
        "seed",
        "environment"
      ],
      "output_types": [
        "plant-mesh",
        "garden-recipe",
        "ecology-data"
      ],
      "determinism_level": "D1",
      "source": "moor-living-garden.html",
      "verification_refs": [
        "tests/pulse-checks.cjs"
      ],
      "status": "verified-interface-replay-pending"
    },
    {
      "generator_id": "effects-studio",
      "version": "1",
      "provides": [
        "particles",
        "beams",
        "ribbons",
        "halos",
        "shards"
      ],
      "input_types": [
        "seed",
        "moor.effect-recipe"
      ],
      "output_types": [
        "effect-frame",
        "effect-recipe"
      ],
      "determinism_level": "D2",
      "source": "effects-studio.html",
      "verification_refs": [
        "tests/effects-checks.cjs",
        "tests/effects-workbench-checks.cjs"
      ],
      "status": "verified-existing"
    },
    {
      "generator_id": "struct",
      "version": "1",
      "provides": [
        "procedural-structure",
        "furnishing-geometry"
      ],
      "input_types": [
        "seed",
        "structure-params"
      ],
      "output_types": [
        "structure-geometry"
      ],
      "determinism_level": "D1",
      "source": "components/struct/struct.js",
      "verification_refs": [
        "tests/pulse-checks.cjs"
      ],
      "status": "existing-needs-replay-proof"
    },
    {
      "generator_id": "road-atlas",
      "version": "2.5",
