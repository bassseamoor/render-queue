        "road-network",
        "urban-layout",
        "navigation-graph"
      ],
      "input_types": [
        "seed",
        "terrain",
        "road-params"
      ],
      "output_types": [
        "roads",
        "street-graph",
        "route-graph"
      ],
      "determinism_level": "D1",
      "source": "road-atlas-pipeline.js",
      "verification_refs": [
        "tests/road-atlas/verify_ordered.py",
        "tests/road-atlas/verify_streets.py",
        "tests/road-atlas/verify_navigation.py"
      ],
      "status": "verified-existing"
    },
    {
      "generator_id": "roadtrip-world",
      "version": "1",
      "provides": [
        "procedural-roadtrip-world",
        "materials",
        "world-scenes"
      ],
      "input_types": [
        "seed",
        "world-params"
      ],
      "output_types": [
        "world-scene"
      ],
      "determinism_level": "D1",
      "source": "roadtrip-world.js",
      "verification_refs": [
        "tests/roadtrip-checks.mjs"
      ],
      "status": "verified-existing"
    },
    {
      "generator_id": "wall-mirror",
      "version": "1.0.0",
      "provides": [
        "parametric-wall-mirror"
      ],
      "input_types": [
        "shape",
        "frame"
      ],
      "output_types": [
        "mirror-recipe",
        "webgl-preview"
      ],
      "determinism_level": "D2",
      "source": "moor-wall-mirror.html",
      "verification_refs": [
        "tests/pulse-checks.cjs"
      ],
      "status": "verified-interface"
    },
    {
      "generator_id": "ambience",
      "version": "1",
      "provides": [
        "procedural-ambience"
      ],
      "input_types": [
        "seed",
        "sample-rate",
        "seconds",
        "kind"
      ],
      "output_types": [
        "stereo-buffer"
      ],
      "determinism_level": "D1",
      "source": "pulse-tools/tool-ambience.js",
      "verification_refs": [
        "tests/pulse-checks.cjs"
      ],
      "status": "existing-needs-replay-proof"
    },
    {
      "generator_id": "wonder-native-effects",
      "version": "1",
      "provides": [
        "effect-variant-stream"
      ],
      "input_types": [
        "seed",
        "effect-recipe"
      ],
      "output_types": [
        "wonder-card"
      ],
      "determinism_level": "D2",
      "source": "wonder-generators.json",
      "verification_refs": [
        "tests/wonder-haven-checks.cjs",
        "tests/wonder-scroll-checks.cjs"
      ],
      "status": "verified-presentation"
    }
  ],
  "sources": [
    "pulse-manifest.json",
    "wonder-generators.json",
    "pulse-component-extensions.js",
    "blueprint/seeded-procedural-toolchain.blueprint.json"
  ]
}
